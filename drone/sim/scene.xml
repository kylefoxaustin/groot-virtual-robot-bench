
<mujoco model="guidance_drone">
  <option timestep="0.02" gravity="0 0 0"/>
  <visual><global offwidth="384" offheight="384"/></visual>
  <asset><texture name="sky" type="skybox" builtin="gradient" rgb1=".45 .65 .9" rgb2=".85 .93 1" width="256" height="256"/>
    <texture name="grid" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".25 .35 .45" width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="20 20" reflectance="0.1"/>
  </asset>
  <worldbody>
    <light pos="0 0 8" dir="0 0 -1" diffuse="1 1 1"/>
    <geom name="floor" type="plane" size="30 30 .1" material="grid"/>
    <!-- colored landmark pillars (visual anchors for the ViT) -->
    <geom name="red"    type="box" pos="8 0 1.5"  size=".4 .4 1.5" rgba=".85 .15 .15 1"/>
    <geom name="green"  type="box" pos="-6 5 1.5" size=".4 .4 1.5" rgba=".15 .7 .2 1"/>
    <geom name="blue"   type="box" pos="0 -8 1.5" size=".4 .4 1.5" rgba=".15 .3 .85 1"/>
    <geom name="yellow" type="box" pos="-7 -6 1.5" size=".4 .4 1.5" rgba=".9 .8 .1 1"/>
    <!-- the target (where we want to fly) -->
    <site name="target" pos="8 0 2" size="0.35" rgba="1 1 1 .4"/>
    <!-- the drone: a free-floating body we move kinematically via mocap -->
    <body name="drone" mocap="true" pos="0 0 2">
      <geom type="box" size=".18 .18 .05" rgba=".1 .1 .12 1"/>
      <geom type="cylinder" fromto=".18 .18 0 .18 .18 .04" size=".08" rgba=".3 .3 .3 1"/>
      <geom type="cylinder" fromto="-.18 .18 0 -.18 .18 .04" size=".08" rgba=".3 .3 .3 1"/>
      <geom type="cylinder" fromto=".18 -.18 0 .18 -.18 .04" size=".08" rgba=".3 .3 .3 1"/>
      <geom type="cylinder" fromto="-.18 -.18 0 -.18 -.18 .04" size=".08" rgba=".3 .3 .3 1"/>
      <camera name="fpv" pos="0.2 0 0" xyaxes="0 -1 0 0 0 1" fovy="70"/>
    </body>
  </worldbody>
</mujoco>
