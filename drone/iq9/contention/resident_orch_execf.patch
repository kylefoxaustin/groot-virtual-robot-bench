+// ---- instrumented / fast / stubbed variants of EXEC (drone contention study) --------------------
+// mode 0 = EXECT   : the EXEC path unchanged, with per-stage wall + CPU timers (profile)
+// mode 1 = EXECF   : EXEC with the output written by ONE fwrite of the client buffer (same bytes, same path)
+// mode 2 = EXECNOP : EXEC's host work (list parse, input read/populate, byte-wise output write) with
+//                    graphExecute REPLACED by usleep(sleepUs) - the scan's host load with NO NPU work
+// mode 3 = EXECONLY: graphExecute only on the already-populated client buffers - NPU work, minimal host
+static uint64_t cpuUs(clockid_t c) { timespec t; clock_gettime(c, &t); return (uint64_t)t.tv_sec * 1000000ull + t.tv_nsec / 1000; }
+bool execGraphG(const std::string &name, const std::string &listFile, const std::string &outDir, int mode,
+                uint64_t sleepUs, std::string &rep) {
+  auto it = g_graphs.find(name);
+  if (it == g_graphs.end()) { std::cout << "ERR unknown graph: " << name << std::endl; return false; }
+  Loaded &L = it->second;
+  uint64_t w0 = nowUs(), c0 = cpuUs(CLOCK_THREAD_CPUTIME_ID), p0 = cpuUs(CLOCK_PROCESS_CPUTIME_ID);
+  uint64_t wRl = 0, wPop = 0, wEx = 0, wWr = 0, cEx = 0, pEx = 0, cWr = 0;
+  size_t numPop = 1, batch = 1;
+  if (mode != 3) {
+    std::vector<std::vector<std::vector<std::string>>> fileLists;
+    std::vector<std::unordered_map<std::string, uint32_t>> nameToIdx;
+    bool ok = false;
+    std::tie(fileLists, nameToIdx, ok) = sample_app::readInputLists({listFile});
+    if (!ok || fileLists.empty() || fileLists[0].empty()) { std::cout << "ERR readInputLists: " << listFile << std::endl; return false; }
+    uint64_t w1 = nowUs(); wRl = w1 - w0;
+    iotensor::StatusCode s;
+    std::tie(s, numPop, batch) = g_io.populateInputTensors(
+        0, fileLists[0], 0, false, nameToIdx[0], L.inputs, (*L.graphsInfo)[0], iotensor::InputDataType::FLOAT);
+    if (s != iotensor::StatusCode::SUCCESS) { std::cout << "ERR populateInputTensors: " << name << std::endl; return false; }
+    wPop = nowUs() - w1;
+  }
+  uint64_t e0 = nowUs(), ce0 = cpuUs(CLOCK_THREAD_CPUTIME_ID), pe0 = cpuUs(CLOCK_PROCESS_CPUTIME_ID);
+  if (mode == 2) { usleep(sleepUs); }
+  else {
+    Qnn_ErrorHandle_t e = g_fp.qnnInterface.graphExecute((*L.graphsInfo)[0].graph, L.inputs, nIn(L),
+                                                         L.outputs, nOut(L), nullptr, nullptr);
+    if (e != QNN_GRAPH_NO_ERROR) { std::cout << "ERR graphExecute rc=" << e << " graph=" << name << std::endl; return false; }
+  }
+  wEx = nowUs() - e0; cEx = cpuUs(CLOCK_THREAD_CPUTIME_ID) - ce0; pEx = cpuUs(CLOCK_PROCESS_CPUTIME_ID) - pe0;
+  uint64_t r0 = nowUs(), cr0 = cpuUs(CLOCK_THREAD_CPUTIME_ID);
+  if (mode == 0 || mode == 2) {
+    if (g_io.writeOutputTensors(0, 0, (*L.graphsInfo)[0].graphName, L.outputs, nOut(L),
+                                iotensor::OutputDataType::FLOAT_ONLY, 1, outDir, numPop, batch) !=
+        iotensor::StatusCode::SUCCESS) { std::cout << "ERR writeOutputTensors: " << name << std::endl; return false; }
+  } else if (mode == 1) {
+    // same file layout as writeOutputTensors(graphsCount=1, startIdx=0, numPop=1): <outDir>/Result_0/<tensor>.raw
+    std::string dir = outDir + "/Result_0";
+    if (!pal::Directory::makePath(dir)) { std::cout << "ERR makePath " << dir << std::endl; return false; }
+    for (uint32_t i = 0; i < nOut(L); ++i) {
+      if (dtype(L.outputs[i]) != QNN_DATATYPE_FLOAT_32) { std::cout << "ERR EXECF needs FLOAT_32 outputs" << std::endl; return false; }
+      const char *tn = QNN_TENSOR_GET_NAME(L.outputs[i]);
+      std::string f = dir + "/" + ((tn && strlen(tn)) ? std::string(tn) : ("Output_" + std::to_string(i))) + ".raw";
+      FILE *fo = fopen(f.c_str(), "wb"); if (!fo) { std::cout << "ERR open " << f << std::endl; return false; }
+      size_t n = telems(L.outputs[i]) * sizeof(float);
+      size_t got = fwrite(QNN_TENSOR_GET_CLIENT_BUF(L.outputs[i]).data, 1, n, fo); fclose(fo);
+      if (got != n) { std::cout << "ERR short write " << f << std::endl; return false; }
+    }
+  }
+  wWr = nowUs() - r0; cWr = cpuUs(CLOCK_THREAD_CPUTIME_ID) - cr0;
+  uint64_t wT = nowUs() - w0, cT = cpuUs(CLOCK_THREAD_CPUTIME_ID) - c0, pT = cpuUs(CLOCK_PROCESS_CPUTIME_ID) - p0;
+  rep = std::to_string(wEx) + " rl=" + std::to_string(wRl) + " pop=" + std::to_string(wPop) + " ex=" + std::to_string(wEx) +
+        " wr=" + std::to_string(wWr) + " tot=" + std::to_string(wT) + " cpu_ex=" + std::to_string(cEx) + " pcpu_ex=" + std::to_string(pEx) +
+        " cpu_wr=" + std::to_string(cWr) + " cpu_tot=" + std::to_string(cT) + " pcpu_tot=" + std::to_string(pT);
+  return true;
+}
