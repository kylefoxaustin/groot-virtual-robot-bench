+// ---- BFRAME: drone policy backbone (ViT -> mlp1/scatter -> LLM -> vlln+vl_self_attn -> mean-pool)
+// frameDir: input_ids.raw (int64, Npad), attention_mask.raw (f32, Npad; 1 = valid, valid tokens first),
+//           pixel_values.raw (f32 1x3x224x224, unless pixelPath given). constDir: position_ids.raw (ViT).
+// The LLM is causal, so right-padding to its compiled length leaves the valid tokens exact.
+// vl_self_attention is bidirectional with no mask, so it is compiled at exactly nValid tokens and
+// fed only the valid LLM rows. Output: <outPrefix>.pool = mean over the nValid vlln rows (2048 f32).
+// dump!=0 also writes <outPrefix>.llm (nValid x 2048) and <outPrefix>.vlln (nValid x 2048).
+struct BTimes { uint64_t vit, mlp1, gluevlm, llm, vlln, pool; };
+bool runBackboneFrame(const std::string &frameDir, const std::string &constDir, const std::string &outPrefix,
+                      const std::string &pixelPath, bool dump, BTimes &tm) {
+  Loaded &vit = g_graphs.at("groot_vit");
+  Loaded &llm = g_graphs.at("groot_llm");
+  Loaded &vlln = g_graphs.at("vlln_vl_self_attention_47");
+  uint64_t g0;
+  std::string idp = frameDir + "/input_ids.raw";
+  FILE *fi = fopen(idp.c_str(), "rb");
+  if (!fi) { std::cout << "ERR open input_ids" << std::endl; return false; }
+  fseek(fi, 0, SEEK_END); long ibytes = ftell(fi); fseek(fi, 0, SEEK_SET);
+  size_t N = ibytes / 8;
+  std::vector<int64_t> ids(N);
+  if (fread(ids.data(), 8, N, fi) != N) { fclose(fi); std::cout << "ERR read input_ids" << std::endl; return false; }
+  fclose(fi);
+  std::vector<float> amask;
+  if (!readF32(frameDir + "/attention_mask.raw", amask, N)) return false;
+  size_t nValid = 0;
+  for (size_t i = 0; i < N; ++i) { if (amask[i] != 0.0f) { if (nValid != i) { std::cout << "ERR mask not prefix-valid" << std::endl; return false; } ++nValid; } }
+  { Qnn_Tensor_t *pv = byName(vit.inputs, nIn(vit), "pixel_values");
+    Qnn_Tensor_t *pid = byName(vit.inputs, nIn(vit), "position_ids");
+    if (!pv || !pid) { std::cout << "ERR vit inputs" << std::endl; return false; }
+    if (!setInputFromF32File(*pv, pixelPath)) return false;
+    if (!setInputFromF32File(*pid, constDir + "/position_ids.raw")) return false; }
+  if (!execOnly(vit, tm.vit)) { std::cout << "ERR exec vit" << std::endl; return false; }
+  float *vit_out = fbuf(vit.outputs[0]);
+  if (telems(vit.outputs[0]) != (size_t)NPATCH * DVIT) { std::cout << "ERR vit out size" << std::endl; return false; }
+  std::vector<float> proj((size_t)NPATCH * DLLM);
+  g0 = nowUs();
+  g_sgemm(CblasRowMajor, CblasNoTrans, CblasTrans, NPATCH, DLLM, DVIT, 1.0f,
+          vit_out, DVIT, g_glue.mlp1_w.data(), DVIT, 0.0f, proj.data(), DLLM);
+  for (int i = 0; i < NPATCH; ++i) { float *pr = &proj[(size_t)i * DLLM]; for (int j = 0; j < DLLM; ++j) pr[j] += g_glue.mlp1_b[j]; }
+  tm.mlp1 = nowUs() - g0;
+  Qnn_Tensor_t *ie = byName(llm.inputs, nIn(llm), "inputs_embeds");
+  Qnn_Tensor_t *am = byName(llm.inputs, nIn(llm), "attention_mask");
+  if (!ie || !am) { std::cout << "ERR llm inputs" << std::endl; return false; }
+  if (telems(*ie) != N * DLLM) { std::cout << "ERR inputs_embeds size " << telems(*ie) << "/" << N * DLLM << std::endl; return false; }
+  g0 = nowUs();
+  { float *dst = fbuf(*ie); size_t pk = 0;
+    for (size_t i = 0; i < N; ++i) {
+      int64_t id = ids[i]; const float *src;
+      if (id == g_glue.image_token) { if (pk >= (size_t)NPATCH) { std::cout << "ERR too many image tokens" << std::endl; return false; } src = &proj[pk * DLLM]; ++pk; }
+      else { if (id < 0 || id >= EMBED_ROWS) { std::cout << "ERR token id range " << id << std::endl; return false; } src = &g_glue.embed[(size_t)id * DLLM]; }
+      memcpy(&dst[i * DLLM], src, DLLM * sizeof(float));
+    }
+    if (pk != (size_t)NPATCH) { std::cout << "ERR image tokens " << pk << "/" << NPATCH << std::endl; return false; } }
+  tm.gluevlm = nowUs() - g0;
+  if (!setInputFromF32File(*am, frameDir + "/attention_mask.raw")) return false;
+  if (!execOnly(llm, tm.llm)) { std::cout << "ERR exec llm" << std::endl; return false; }
+  { Qnn_Tensor_t *bf = byName(vlln.inputs, nIn(vlln), "backbone_features");
+    if (!bf || telems(*bf) != nValid * DLLM) { std::cout << "ERR vlln in size " << (bf ? telems(*bf) : 0) << "/" << nValid * DLLM << std::endl; return false; }
+    memcpy(fbuf(*bf), fbuf(llm.outputs[0]), nValid * DLLM * sizeof(float)); }
+  if (!execOnly(vlln, tm.vlln)) { std::cout << "ERR exec vlln" << std::endl; return false; }
+  if (telems(vlln.outputs[0]) != nValid * DLLM) { std::cout << "ERR vlln out size" << std::endl; return false; }
+  g0 = nowUs();
+  std::vector<double> acc(DLLM, 0.0);
+  { const float *v = fbuf(vlln.outputs[0]);
+    for (size_t r = 0; r < nValid; ++r) for (int j = 0; j < DLLM; ++j) acc[j] += v[r * DLLM + j]; }
+  std::vector<float> pooled(DLLM);
+  for (int j = 0; j < DLLM; ++j) pooled[j] = (float)(acc[j] / (double)nValid);
+  tm.pool = nowUs() - g0;
+  auto wr = [](const std::string &p, const float *d, size_t n) {
+    FILE *fo = fopen(p.c_str(), "wb"); if (!fo) return false; fwrite(d, sizeof(float), n, fo); fclose(fo); return true; };
+  if (!wr(outPrefix + ".pool", pooled.data(), DLLM)) { std::cout << "ERR write pool" << std::endl; return false; }
+  if (dump) {
+    wr(outPrefix + ".llm", fbuf(llm.outputs[0]), nValid * DLLM);
+    wr(outPrefix + ".vlln", fbuf(vlln.outputs[0]), nValid * DLLM);
+  }
+  return true;
+}
