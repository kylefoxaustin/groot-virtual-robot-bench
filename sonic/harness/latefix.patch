+    struct timespec sonic_next; clock_gettime(CLOCK_MONOTONIC, &sonic_next);
+    std::fprintf(stderr, "[rtctl] main loop: clock_nanosleep(TIMER_ABSTIME) 20 ms (upstream busy-spin replaced)\n");
+    while (!custom.operator_state.stop) {
