+      if (sonic_next.tv_nsec >= 1000000000L) { sonic_next.tv_nsec -= 1000000000L; sonic_next.tv_sec += 1; }
+      clock_nanosleep(CLOCK_MONOTONIC, TIMER_ABSTIME, &sonic_next, nullptr);
+    }
+  } else {
+    while (!custom.operator_state.stop) { sleep(0.02); }
